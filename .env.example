# Copy to `.env` and fill in. Everything is optional: with the defaults below
# (fake backends) the system runs with NO external keys.
#
# Config is organized into three swappable provider slots. The var NAMES are
# vendor-neutral; the values shown are ONE example combination (Groq + Jina +
# Qdrant), not privileged defaults — any provider behind each interface works
# the same way.

# --- LLM slot ---
# LLM_BACKEND: fake | groq | openai | anthropic | gemini | ollama
LLM_BACKEND=fake
# Key for the selected LLM backend (not needed for fake or ollama).
LLM_API_KEY=
# Model for the backend, e.g. groq: llama-3.3-70b-versatile | openai: gpt-4o-mini
# | anthropic: claude-haiku-4-5-20251001 | gemini: gemini-2.0-flash | ollama: llama3.1
MODEL=llama-3.3-70b-versatile
# Optional: override the endpoint (Azure/proxy/OpenAI-compatible, or Ollama host).
LLM_BASE_URL=
# Optional. Leave EMPTY to use the provider's own default (nothing is sent).
# Set 0 if you want reproducible sub-questions: measured same quality with fewer
# run-to-run changes (see eval/temp_ab.py). Note when set: OpenAI reasoning
# models reject this parameter, and Anthropic only accepts 0.0-1.0.
LLM_TEMPERATURE=

# --- Embedder slot ---
# EMBED_BACKEND: fake | jina | voyage | openai | gemini | ollama
EMBED_BACKEND=fake
# Key for the selected embedder backend (not needed for fake or ollama).
EMBED_API_KEY=
# Dimension MUST match the model: jina v3 = 1024, voyage-3 = 1024,
# openai 3-small = 1536, gemini-embedding-001 = 768 (configurable), ollama nomic-embed-text
# = 768. You cannot mix
# embedders in one collection — switching means a fresh collection / re-embed.
EMBED_DIM=1024
EMBED_BASE_URL=

# --- Retrieval tuning ---
# Hybrid read: fuse dense (embedding) + lexical (BM25) rankings with RRF. Helps
# queries that hinge on rare terms (names, titles); set false for dense-only.
HYBRID_SEARCH=true
# Cache query decompositions (LRU) so repeat queries skip the planner LLM call.
PLAN_CACHE=true

# --- Episodic memory (additive; OFF by default) ---
# The event-log / timeline layer. Leave false for exactly today's behavior;
# set true to opt in (add/search gain events, timelines, temporal routing).
EPISODIC_ENABLED=false
# Branch matcher (three-zone). AUTO auto-assigns; [GRAY_LOW, AUTO) asks the LLM.
# AUTO defaults per embedder (jina 0.80, openai 0.72) if left empty. Tune via
# eval/episodic. Entity names are stripped before embedding, so shared proper
# nouns don't cause false merges.
BRANCH_MATCH_AUTO=
BRANCH_MATCH_GRAY_LOW=0.40
# Entity resolution v2: match an unknown mention to an existing entity by
# embedding + LLM confirmation (e.g. "D" -> "Dana"). Off = cheap exact-alias
# matching (under-merges rather than risk a wrong merge).
ENTITY_V2=false
ENTITY_MATCH_MIN=0.60
# Optional ontology pack to pre-seed a user's branch registry for a known domain
# (e.g. "personal"). Empty (default) = general-purpose: seed nothing; the
# ontology emerges per-user, kept consistent by feeding the registry back into
# the extractor/namer/planner prompts.
ONTOLOGY_PACK=
# Read-side branch_hint resolution (relative-best): resolve to the top-scoring
# branch only when it clears FLOOR and beats the runner-up by MARGIN; else the
# bounded fallback is used. Exact vocab matches short-circuit before this.
BRANCH_RESOLVE_FLOOR=0.30
BRANCH_RESOLVE_MARGIN=0.10
# Summarize a branch's oldest segment once it exceeds this many nodes.
CHECKPOINT_EVERY=50
# Empty = store episodic data with STORE_BACKEND; or "sqlite" for a relational
# episodic side paired with a vector store for facts.
EPISODIC_STORE=

# --- Reconciler tuning ---
# Write-side similarity gate: a candidate whose nearest fact scores below this
# is ADDed directly (distinct facts must not over-merge). Tuned via eval/tune.py
# for Jina; re-tune per embedder (it's dimension/space dependent).
RECONCILE_MIN_SIM=0.5

# --- Vector store slot ---
# STORE_BACKEND: qdrant | ...
STORE_BACKEND=qdrant
COLLECTION=atomir_memories
# If STORE_URL is set -> server mode; otherwise embedded/local at STORE_PATH.
STORE_URL=
STORE_PATH=./qdrant_data
